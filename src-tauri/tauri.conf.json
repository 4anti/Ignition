{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ignition",
  "mainBinaryName": "Ignition",
  "version": "0.1.0",
  "identifier": "com.startuppicker.app",
  "build": {
    "beforeDevCommand": "python src-tauri/dev_ui.py",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
